[Unit]
Description=Block Mecha worker containers from cloud metadata
After=docker.service
Requires=docker.service
Before=mecha.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/mecha-docker-egress-guard
RemainAfterExit=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
